{"files":{"account.lua":"-- Normal mobile login, verified against the authenticated account page.\n-- No shared accounts, password persistence, or cookie import.\nlocal M={}\nfunction M.new(ctx,H)\n    local A,state={}\n    local function valid(s)\n        return type(s)==\"table\" and type(s.name)==\"string\" and s.name~=\"\"\n            and type(s.cookies)==\"table\" and next(s.cookies)~=nil\n    end\n    local function clear()\n        assert(ctx.secrets.clear(\"session\"),\"session removal failed\")\n        state=nil;H.cookies={night=\"0\"}\n    end\n    local function profile(html)\n        local doc=H.doc(html)\n        local name=H.text(H.first(doc,\"span.user-name\"))\n        assert(name~=\"\" and not H.first(doc,'input[name=\"password\"]'),\"missing authenticated profile\")\n        -- The mobile profile exposes a display name. Never derive a user ID\n        -- from that name, an avatar URL, or an opaque cookie.\n        return {name=name}\n    end\n    function A.restore()\n        local saved=ctx.secrets.get_json(\"session\")\n        state=valid(saved) and saved or nil\n        H.cookies=state and state.cookies or {night=\"0\"}\n        H.expire=clear;H.logged=A.logged\n    end\n    function A.logged() return valid(state)==true end\n    function A.requireLogin()\n        if not A.logged() then H.fail(\"auth_required\",\"请先登录自己的哔哩轻小说账号\") end\n    end\n    function A.login(username,password,call)\n        assert(type(username)==\"string\" and #username>0 and #username<=256 and type(password)==\"string\" and #password>0 and #password<=512,\"invalid credentials\")\n        local cookies={night=\"0\"}\n        local form=H.doc(H.request(\"/login.php\",call,nil,nil,nil,cookies))\n        local f=assert(H.first(form,'form[name=\"frmlogin\"]'),\"login form changed\")\n        assert(H.first(f,'input[name=\"username\"]') and H.first(f,'input[name=\"password\"]'),\"login fields changed\")\n        if H.first(f,'input[name=\"checkcode\"]') then H.unsupported(\"站点本次要求验证码，当前无法完成登录\") end\n        local action=H.attr(f,\"action\")\n        if action:sub(1,#H.base)==H.base then action=action:sub(#H.base+1) end\n        assert(action:match(\"^/login%.php%?do=submit\") and not action:find(\"[%c]\"),\"unknown login target\")\n        local fields={\"username=\"..H.encode(username),\"password=\"..H.encode(password)}\n        local act=false\n        for _,input in ipairs(f:select(\"input\")) do\n            local name=H.attr(input,\"name\")\n            if H.attr(input,\"type\")==\"hidden\" then\n                assert(name~=\"username\" and name~=\"password\",\"duplicate credential field\")\n                fields[#fields+1]=H.encode(name)..\"=\"..H.encode(H.attr(input,\"value\"))\n                if name==\"act\" and H.attr(input,\"value\")==\"login\" then act=true end\n            end\n        end\n        assert(act,\"login action changed\")\n        local html=H.request(action,call,\"POST\",table.concat(fields,\"&\"),nil,cookies)\n        if html:find(\"该用户不存在\",1,true) then H.fail(\"auth_required\",\"站点提示账号不存在，请确认登录账号和大小写\") end\n        if html:find('name=\"password\"',1,true) or html:find(\"密码错误\",1,true) or html:find(\"密码不正确\",1,true) then\n            H.fail(\"auth_required\",\"账号或密码未通过验证，请确认个人账号信息\")\n        end\n        local ok,verified=pcall(profile,H.request(\"/user.php\",call,nil,nil,nil,cookies))\n        if not ok then H.fail(\"auth_required\",\"登录未通过账号页验证，请检查个人账号或站点验证要求\") end\n        local session={name=verified.name,cookies=cookies}\n        assert(valid(session) and ctx.secrets.set_json(\"session\",session),\"session persistence failed\")\n        state=session;H.cookies=cookies\n        if H.reset then H.reset() end\n        return {success=true}\n    end\n    function A.logout()clear();if H.reset then H.reset() end;return {success=true}end\n    function A.profile(call)\n        A.requireLogin()\n        local ok,p=pcall(profile,H.get(\"/user.php\",call))\n        if not ok then clear();H.fail(\"auth_expired\",\"哔哩轻小说登录已失效，请重新登录\") end\n        assert(ctx.secrets.set_json(\"session\",{name=p.name,cookies=H.cookies}),\"session persistence failed\")\n        state.name=p.name;return p\n    end\n    return A\nend\nreturn M\n","comments.lua":"-- Public review previews and lazy original-post loading, no write endpoints.\nlocal M={}\nfunction M.new(ctx,H,account,account_http)\n    account_http=account_http or H\n    local C={}\n    local function path(a)\n        local href=ctx.text.htmlEntitiesToUtf8(H.attr(a,\"href\"))\n        for _,base in ipairs({H.base,account_http.base})do\n            if href:sub(1,#base)==base then href=href:sub(#base+1);break end\n        end\n        return href\n    end\n    local function belongs(doc,id)\n        for _,a in ipairs(doc:select(\"a\")) do\n            local href=path(a)\n            if href==\"/novel/\"..id..\".html\" or href:match(\"^/reviews_\"..id..\"_%d+%.html$\") then return true end\n        end\n        error(\"wrong review parent\")\n    end\n    function C.list(id,request,call)\n        H.id(id);local p=H.page(request)\n        local html=H.get(\"/reviews_\"..id..\"_\"..p..\".html\",call)\n        local doc=H.doc(html);belongs(doc,id)\n        local holder=assert(H.first(doc,\"#list_content\"),\"missing review list\")\n        local items,seen={},{}\n        for _,a in ipairs(holder:select(\"a.book-layout\")) do\n            local rid=assert(path(a):match(\"^/reviewshow_(%d+)_1%.html$\"),\"missing review ID\")\n            assert(not seen[rid],\"duplicate review\");seen[rid]=true\n            local body=assert(H.first(a,\".book-comment-p\"),\"missing preview\")\n            local author=H.text(H.first(a,\".book-meta-l em\"));assert(author~=\"\",\"missing author\")\n            local preview=ctx.text.htmlToPlainText(body:getcontent())\n            local replies=H.text(H.first(a,\".book-meta-r\")):match(\"%d+/(%d+)\")\n            items[#items+1]={id=rid,content=preview,content_complete=false,author={name=author},\n                repliesCount=tonumber(replies) or 0,created_at=H.text(H.first(a,\".book-comment-time\"))}\n        end\n        assert(#items>0 or H.text(holder):find(\"暂无书评\",1,true),\"unrecognized empty review list\")\n        -- The site currently comments out its visual pager, but still emits\n        -- the server's page links. Parse only that pagination fragment.\n        if not H.first(doc,\"#pagelink\") then\n            local pager=html:match('(<div class=\"pagelink\" id=\"pagelink\">.-</div>)')\n            if pager then doc=H.doc(pager) end\n        end\n        return H.paged(doc,p,items,30,function(href)return tonumber(href:match(\"^/reviews_\"..id..\"_(%d+)%.html$\"))end)\n    end\n    function C.details(id,rid,call)\n        H.id(id);H.id(rid);account.requireLogin()\n        local doc=H.doc(account_http.get(\"/reviewshow_\"..rid..\"_1.html\",call));belongs(doc,id)\n        local body=assert(H.first(doc,\".book-comment-p\"),\"missing original post\")\n        local row=body.parent\n        local author=H.text(H.first(row,\".book-meta-l em\"));assert(author~=\"\",\"missing author\")\n        return {id=rid,content=ctx.text.htmlToPlainText(body:getcontent()),content_complete=true,\n            author={name=author},created_at=H.text(H.first(row,\".book-comment-time\"))}\n    end\n    return C\nend\nreturn M\n","decoder.lua":"-- Read the site's numeric paragraph-order parameters as data. No JavaScript\n-- evaluation, browser, external descramble server or hard-coded chapter text.\nlocal D={}\nlocal function arithmetic(s)\n    assert(type(s)==\"string\" and #s<=256,\"expression limit\")\n    local pos,tokens=1,0\n    local expression\n    local function space() local _,last=s:find(\"^%s*\",pos);pos=(last or pos-1)+1 end\n    local function bounded(n)\n        assert(n==n and math.abs(n)<=9007199254740991 and n%1==0,\"invalid arithmetic result\");return n\n    end\n    local function atom(depth)\n        assert(depth<=16,\"expression depth\")\n        space();tokens=tokens+1;assert(tokens<=128,\"expression tokens\")\n        local c=s:sub(pos,pos)\n        if c==\"+\" or c==\"-\" then pos=pos+1;local n=atom(depth+1);return c==\"-\" and -n or n end\n        if c==\"(\" then\n            pos=pos+1;local n=expression(depth+1);space();assert(s:sub(pos,pos)==\")\",\"missing bracket\");pos=pos+1;return n\n        end\n        local token=s:match(\"^0[xX][%da-fA-F]+\",pos) or s:match(\"^%d+\",pos)\n        assert(token,\"only numeric expressions are accepted\");pos=pos+#token;return bounded(assert(tonumber(token)))\n    end\n    local function product(depth)\n        local n=atom(depth)\n        while true do\n            space();local op=s:sub(pos,pos)\n            if op~=\"*\" and op~=\"/\" and op~=\"%\" then return n end\n            pos=pos+1;local rhs=atom(depth)\n            if op==\"*\" then n=bounded(n*rhs)\n            elseif op==\"/\" then assert(rhs~=0);n=bounded(n/rhs)\n            else assert(rhs>0 and n>=0);n=bounded(n%rhs) end\n        end\n    end\n    expression=function(depth)\n        local n=product(depth)\n        while true do\n            space();local op=s:sub(pos,pos)\n            if op~=\"+\" and op~=\"-\" then return n end\n            pos=pos+1;local rhs=product(depth);n=bounded(op==\"+\" and n+rhs or n-rhs)\n        end\n    end\n    local value=expression(0);space();assert(pos>#s,\"unexpected expression suffix\");return value\nend\nD.arithmetic=arithmetic\nfunction D.parameters(js)\n    assert(type(js)==\"string\" and #js<=262144,\"script limit\")\n    local mul,offset=js:match(\"var%s+[%w_$]+%s*=%s*[^;]-Number%s*%(%s*[%w_$]+%s*%)%s*,%s*([^,)]+)%s*%)%s*,%s*([^,)]+)%s*%)%s*,\")\n    assert(mul and offset,\"unknown chapter seed formula\")\n    local variable,a,c,mod=js:match(\"([%w_$]+)%s*=%s*[^;]-%(%s*%1%s*,%s*([^,)]+)%s*%)%s*,%s*([^,)]+)%s*%)%s*,%s*([^;)]+)%s*%)%s*;\")\n    assert(variable and a and c and mod,\"unknown chapter shuffle formula\")\n    local fixed\n    for _,value,_,second in js:gmatch(\"var%s+([%w_$]+)%s*=%s*([^;]+);function%s+[%w_$]+%s*%(([%w_$]+),([%w_$]+)%)\") do\n        if second==variable then assert(fixed==nil,\"ambiguous fixed paragraphs\");fixed=arithmetic(value) end\n    end\n    assert(fixed,\"unknown fixed paragraph count\")\n    local p={fixed=fixed,mul=arithmetic(mul),offset=arithmetic(offset),a=arithmetic(a),c=arithmetic(c),mod=arithmetic(mod)}\n    assert(p.fixed>=0 and p.fixed<=1000 and p.mul>0 and p.offset>=0 and p.a>0 and p.c>=0\n        and p.mod>p.a and p.mod>p.c and p.a*p.mod+p.c<=9007199254740991,\"invalid shuffle parameters\")\n    return p\nend\nfunction D.restore(body,cid,params)\n    local paragraphs,slots={},{}\n    for i,node in ipairs(body.nodes) do\n        if node.name:lower()==\"p\" and node:getcontent():gsub(\"%s+\",\"\")~=\"\" then\n            paragraphs[#paragraphs+1]=node;slots[#slots+1]=i\n        end\n    end\n    local n=#paragraphs\n    assert(n<=10000,\"paragraph limit\")\n    local indices,shuffled={},{}\n    for i=1,n do if i<=params.fixed then indices[#indices+1]=i else shuffled[#shuffled+1]=i end end\n    local seed=assert(tonumber(cid))*params.mul+params.offset\n    assert(seed*params.a+params.c<=9007199254740991,\"chapter seed limit\")\n    for i=#shuffled,2,-1 do\n        seed=(seed*params.a+params.c)%params.mod\n        local j=math.floor(seed/params.mod*i)+1\n        shuffled[i],shuffled[j]=shuffled[j],shuffled[i]\n    end\n    for _,i in ipairs(shuffled) do indices[#indices+1]=i end\n    local restored={}\n    for i,node in ipairs(paragraphs) do restored[indices[i]]=node end\n    local replacements={}\n    for i,slot in ipairs(slots) do replacements[slot]=restored[i] end\n    local out={}\n    for i,node in ipairs(body.nodes) do\n        node=replacements[i] or node\n        local tag=node.name:lower()\n        if tag==\"p\" or tag==\"img\" or tag==\"br\" or tag:match(\"^h[1-4]$\") then\n            out[#out+1]=node.root._text:sub(node._openstart,node._closeend)\n        end\n    end\n    assert(#out>0,\"empty chapter\");return table.concat(out,\"\\n\")\nend\nreturn D\n","html.lua":"-- Small source-local HTTP/HTML helpers; no host modules or browser execution.\nlocal M={}\nfunction M.new(ctx,base)\n    local H={base=base,cookies={night=\"0\"}}\n    function H.attr(n,k) return n and n.attributes and n.attributes[k] or \"\" end\n    function H.first(n,q) return n and n:select(q)[1] end\n    function H.text(n) return n and (ctx.text.htmlEntitiesToUtf8(n:textonly()):gsub(\"^%s+\",\"\"):gsub(\"%s+$\",\"\")) or \"\" end\n    function H.doc(s) assert(type(s)==\"string\" and #s>0 and #s<=2*1024*1024);return assert(ctx.html.parse(s,2000000)) end\n    function H.id(s) assert(type(s)==\"string\" and #s<=32 and s:match(\"^%d+$\"),\"invalid ID\");return s end\n    function H.encode(s) return (s:gsub(\"([^%w%-_%.~])\",function(c)return string.format(\"%%%02X\",c:byte()) end)) end\n    function H.url(s)\n        if not s or s==\"\" then return nil end\n        s=ctx.text.htmlEntitiesToUtf8(s)\n        if s:sub(1,2)==\"//\" then s=\"https:\"..s elseif s:sub(1,1)==\"/\" then s=base..s end\n        assert(s:match(\"^https://[^/%s]+/\") and not s:find(\"[%c%s]\"),\"invalid resource URL\")\n        return s\n    end\n    function H.page(r)\n        local p=r and r.page or 1\n        assert(type(p)==\"number\" and p>=1 and p%1==0 and p<=1000000,\"invalid page\")\n        return p\n    end\n    function H.firstPage(r) assert(H.page(r)==1,\"pagination unavailable\") end\n    function H.unsupported(message) error(ctx.error(\"unsupported\",message),0) end\n    function H.fail(code,message,retry) error(ctx.error(code,message,nil,nil,retry),0) end\n    function H.request(path,call,method,body,extra,cookies)\n        cookies=cookies or H.cookies\n        for _=1,5 do\n            assert(type(path)==\"string\" and path:sub(1,1)==\"/\" and path:sub(1,2)~=\"//\" and not path:find(\"[%c]\"),\"invalid same-origin path\")\n            if call and (call.cancelled or call.isCancelled and call.isCancelled()) then H.fail(\"cancelled\",\"请求已取消\") end\n            local timeout=math.min(20,call and call.deadline and call.deadline-ctx.clock.now() or 20)\n            if timeout<=0 then H.fail(\"timeout\",\"请求超时\",true) end\n            local headers={[\"User-Agent\"]=\"Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36\",\n                Accept=\"*/*\",[\"Accept-Language\"]=\"zh-CN,zh;q=0.9\",Referer=base..\"/\",\n                [\"Accept-Encoding\"]=\"gzip\",Cookie=ctx.cookie.toHeader(cookies)}\n            for k,v in pairs(extra or {}) do headers[k]=v end\n            if body then headers[\"Content-Type\"]=\"application/x-www-form-urlencoded\" end\n            local r,reason=ctx.http:requestOnce(method or \"GET\",base..path,headers,body,timeout)\n            -- A public GET interrupted before its response may be tried once.\n            -- Never replay login/search POSTs, TLS alerts or HTTP rejections.\n            local disconnected=type(reason)==\"string\" and ({closed=true,[\"connection reset by peer\"]=true,[\"broken pipe\"]=true})[reason:lower()]\n            if not r and disconnected and (method==nil or method==\"GET\") and body==nil then\n                if call and (call.cancelled or call.isCancelled and call.isCancelled()) then H.fail(\"cancelled\",\"请求已取消\") end\n                local remaining=call and call.deadline and call.deadline-ctx.clock.now() or 20\n                if remaining<=0 then H.fail(\"timeout\",\"请求超时\",true)end\n                r=ctx.http:requestOnce(\"GET\",base..path,headers,nil,math.min(20,remaining))\n            end\n            if not r then H.fail(\"network\",\"小说站连接失败\",true) end\n            ctx.cookie.absorb(cookies,r.headers)\n            local status=r.status_code\n            if status==301 or status==302 or status==303 then\n                local location=r.headers and (r.headers.location or r.headers.Location)\n                assert(type(location)==\"string\",\"missing redirect\")\n                if location:sub(1,#base)==base then location=location:sub(#base+1) end\n                assert(location:sub(1,1)==\"/\" and location:sub(1,2)~=\"//\",\"unexpected cross-origin redirect\")\n                path,method,body=location,\"GET\",nil\n            else\n                if status==403 then H.unsupported(\"站点要求浏览器验证，当前源无法访问\") end\n                if status==401 then H.fail(\"auth_required\",\"当前内容需要登录\") end\n                if status==404 then H.fail(\"not_found\",\"内容不存在\") end\n                if status==429 then H.fail(\"rate_limited\",\"站点请求过于频繁\",true) end\n                if status~=200 then H.fail(\"network\",\"小说站响应失败\",true) end\n                assert(type(r.body)==\"string\" and #r.body<=2*1024*1024,\"response too large\")\n                if r.body:find(\"<title>Just a moment\",1,true) then H.unsupported(\"站点要求浏览器验证\") end\n                return r.body,path\n            end\n        end\n        H.fail(\"protocol_changed\",\"站点跳转次数异常\")\n    end\n    function H.get(path,call)\n        local html=H.request(path,call)\n        local form=html:find('name=\"frmlogin\"',1,true) and html:find('name=\"password\"',1,true)\n        if form then\n            local code=H.logged and H.logged() and \"auth_expired\" or \"auth_required\"\n            if H.expire then H.expire() end\n            H.fail(code,\"哔哩轻小说此功能需要登录个人账号\")\n        end\n        return html\n    end\n    local last_search,search_cache\n    local search_routes,route_order={},{}\n    function H.search(keyword,page,call)\n        local cache_key=keyword..\"\\0\"..page\n        if search_cache and search_cache.key==cache_key and ctx.clock.now()-search_cache.time<120 then return search_cache.html,search_cache.path end\n        local route=page>1 and search_routes[keyword] or nil\n        if page>1 and (not route or page>route.pages) then H.fail(\"invalid_response\",\"搜索分页信息已失效，请重新搜索\")end\n        if page==1 and last_search and ctx.clock.now()-last_search<5 then\n            error(ctx.error(\"rate_limited\",\"两次搜索请至少间隔 5 秒\",nil,nil,true),0)\n        end\n        if not H.cookies.jieqiSearchTicket then\n            local headers={Referer=base..\"/search.html\"}\n            local landing=H.request(\"/search.html\",call,nil,nil,headers)\n            -- Packed script tokens 0/2 are dictionary references to css/js,\n            -- including inside quoted strings; they are not endpoint values.\n            local css,js,redeem=\"css\",\"js\",\"redeem\"\n            H.request(\"/search.html?search_guard=\"..css,call,nil,nil,headers)\n            local script=H.request(\"/search.html?search_guard=\"..js,call,nil,nil,headers)\n            -- The normal search page loads a script assigning one opaque,\n            -- anonymous search cookie. Parse that string; never execute it.\n            local quoted=script:match('document%.cookie%s*=%s*(\"jieqiSearchJs=[^\"]+\")')\n            if not quoted then\n                H.fail(\"unsupported\",\"站点搜索需要浏览器验证，当前未取得搜索许可；请在原站确认后稍后重试\")\n            end\n            local cookie=ctx.json.decode(quoted)\n            local value=cookie:match(\"^jieqiSearchJs=([%w%._%-]+);\")\n            assert(value and #value<=1024,\"invalid search cookie\")\n            H.cookies.jieqiSearchJs=value\n            H.request(\"/search.html?search_guard=\"..redeem..\"&r=\"..math.floor(ctx.clock.timestamp()*1000),call,nil,nil,headers)\n            if not H.cookies.jieqiSearchTicket then H.unsupported(\"站点搜索验证尚未完成，请稍后重试\") end\n        end\n        last_search=ctx.clock.now()\n        local ok,html,path\n        if page>1 then\n            ok,html,path=pcall(H.request,route.stem..\"_\"..page..\".html\",call,nil,nil,{Referer=base..\"/search.html\"})\n        else\n            local body=\"searchkey=\"..H.encode(keyword)..\"&page=\"..page\n            ok,html,path=pcall(H.request,\"/search.html\",call,\"POST\",body,{Referer=base..\"/search.html\"})\n        end\n        -- A ticket is consumed even when the request fails. Never reuse it.\n        H.cookies.jieqiSearchTicket=nil\n        if not ok then error(html,0)end\n        if html==\"\" then\n            H.cookies.jieqiSearchTicket=nil\n            error(ctx.error(\"rate_limited\",\"搜索会话失效或请求过于频繁，请稍后重试\",nil,nil,true),0)\n        end\n        local stem=html:match('href=\"(/search/[^\"%s?#]+)_%d+%.html\"')\n        local current,pages=html:match(\"第%s*(%d+)%s*/%s*(%d+)%s*页\")\n        if stem and tonumber(current)==page and tonumber(pages) and tonumber(pages)<=1000000 then\n            if not search_routes[keyword] then route_order[#route_order+1]=keyword end\n            search_routes[keyword]={stem=stem,pages=tonumber(pages)}\n            if #route_order>4 then search_routes[table.remove(route_order,1)]=nil end\n        end\n        return html,path\n    end\n    function H.rememberSearch(keyword,page,html,path)\n        search_cache={key=keyword..\"\\0\"..page,time=ctx.clock.now(),html=html,path=path}\n    end\n    -- Only an explicit last-page link proves the full server page range.\n    function H.paged(doc,current,items,capacity,number)\n        local max,last=current,nil\n        local links=doc:select(\"#pagelink a\")\n        if #links==0 then links=doc:select(\"a\") end\n        for _,a in ipairs(links) do\n            local n=number(ctx.text.htmlEntitiesToUtf8(H.attr(a,\"href\")))\n            if n then\n                max=math.max(max,n)\n                if (\" \"..H.attr(a,\"class\")..\" \"):find(\" last \",1,true) then last=n end\n            end\n        end\n        local result={items=items,has_more=max>current,next=max>current and {page=current+1} or nil}\n        local pages=last or (max==current and current or nil)\n        if pages then result.pagination={mode=\"page\",page=current,pages=pages,page_size=math.max(capacity,#items,1)} end\n        return result\n    end\n    function H.run(operation,fn,...)\n        local ok,value=pcall(fn,...)\n        if ok then return true,value,nil end\n        if type(value)==\"table\" and value.code then value.operation=operation;return false,nil,value end\n        return false,nil,ctx.error(\"protocol_changed\",\"小说站数据结构变化或返回内容不完整\",operation)\n    end\n    return H\nend\nreturn M\n","main.lua":"return function(ctx)\n    -- Public pages moved together. Keep the original account origin and its\n    -- stored cookies separate; a public migration never moves credentials.\n    local H=ctx.require(\"html\").new(ctx,\"https://www.bilinovel.net\")\n    local account_http=ctx.require(\"html\").new(ctx,\"https://www.bilinovel.com\")\n    local search_http=ctx.require(\"html\").new(ctx,\"https://www.bilinovel.net\")\n    local D=ctx.require(\"decoder\")\n    local account=ctx.require(\"account\").new(ctx,account_http)\n    local comments=ctx.require(\"comments\").new(ctx,H,account,account_http)\n    local last_detail,recommended,script_cache\n    local parse_book\n    local S={capabilities={recommendations=true,latest=true,search=true,categories=true,\n        local_favorites=true,login=true,favorites=false,comments=true,comment_details=true,replies=\"none\",download=true},\n        access={comment_details=\"login\"}}\n    function S:init()account.restore();return true,{success=true},nil end\n    function S:getSession()return true,{logged_in=account.logged()},nil end\n    function S:login(username,password,call)return H.run(\"login\",account.login,username,password,call)end\n    function S:logout()return H.run(\"logout\",account.logout)end\n    function S:getUserProfile(call)return H.run(\"getUserProfile\",account.profile,call)end\n    function S:getComments(id,request,call)return H.run(\"getComments\",comments.list,id,request,call)end\n    function S:getCommentDetails(id,rid,call)return H.run(\"getCommentDetails\",comments.details,id,rid,call)end\n    local function meta(doc,property)\n        for _,n in ipairs(doc:select(\"meta\")) do if H.attr(n,\"property\")==property then return H.attr(n,\"content\") end end\n    end\n    local function list(html,page,home,search)\n        local doc=H.doc(html);local items,seen={},{}\n        for _,a in ipairs(doc:select(home and \"a.module-slide-a\" or \"a.book-layout\")) do\n            local id=H.attr(a,\"href\"):match(\"^/novel/(%d+)%.html$\")\n            if id and not seen[id] then\n                local title=H.text(H.first(a,home and \".module-slide-caption\" or \".book-title\"))\n                assert(title~=\"\",\"missing list title\");seen[id]=true\n                local image=H.first(a,\"img\")\n                local author=H.text(H.first(a,\".book-author\")):gsub(\"^作者%s*\",\"\")\n                local url=H.attr(image,\"data-src\");if url==\"\" then url=H.attr(image,\"src\") end\n                items[#items+1]={id=id,title=title,author=author,cover=H.url(url),description=H.text(H.first(a,\".book-desc\"))}\n            end\n        end\n        if #items==0 then assert(H.text(doc):find(\"没有找到\",1,true) or H.text(doc):find(\"共有 0\",1,true),\"unrecognized empty book list\") end\n        if home then return {items=items,has_more=false,total=#items,pagination={mode=\"page\",page=1,pages=1,page_size=math.max(1,#items)}} end\n        if search then\n            local current,pages=H.text(H.first(doc,\"#pagelink\")):match(\"第%s*(%d+)%s*/%s*(%d+)%s*页\")\n            current,pages=tonumber(current),tonumber(pages)\n            if current and pages then\n                assert(current==page and pages>=page and pages<=1000000,\"unexpected search page\")\n                local total=tonumber(H.text(doc):match(\"共有%s*(%d+)%s*条记录\"))\n                if total and math.ceil(total/30)~=pages then total=nil end\n                return {items=items,total=total,has_more=page<pages,next=page<pages and {page=page+1} or nil,\n                    pagination={mode=\"page\",page=page,pages=pages,page_size=30}}\n            end\n        end\n        return H.paged(doc,page,items,30,function(href)\n            return tonumber(href:match(\"^/top/[%w_]+/(%d+)%.html$\") or href:match(\"^/wenku/[%w_]+_(%d+)_0%.html$\") or href:match(\"[?&]page=(%d+)\"))\n        end)\n    end\n    function S:getRecommendations(request,call)\n        return H.run(\"getRecommendations\",function()\n            if request and request.sort then\n                local sort=request.sort;assert(({weekvisit=true,monthvisit=true,weekvote=true,monthvote=true,lastupdate=true,words=true,goodnum=true,postdate=true})[sort],\"invalid sort\")\n                local p=H.page(request)\n                return list(H.get(\"/wenku/\"..sort..\"_0_0_0_0_0_0_0_\"..p..\"_0.html\",call),p)\n            end\n            H.firstPage(request)\n            if recommended and ctx.clock.now()-recommended.time<120 then return ctx.json.decode(recommended.json) end\n            local result=list(H.get(\"/\",call),1,true)\n            recommended={time=ctx.clock.now(),json=ctx.json.encode(result)};return result\n        end)\n    end\n    function S:getLatest(request,call)\n        return H.run(\"getLatest\",function()local p=H.page(request);return list(H.get(\"/top/lastupdate/\"..p..\".html\",call),p)end)\n    end\n    function S:search(keyword,request,call)\n        return H.run(\"search\",function()\n            assert(type(keyword)==\"string\" and #keyword>0 and #keyword<=512,\"invalid search\")\n            local p=H.page(request)\n            local html,path=search_http.search(keyword,p,call)\n            local direct=path and path:match(\"^/novel/(%d+)%.html$\")\n            local result\n            if direct then\n                assert(p==1,\"unexpected redirected search page\")\n                local doc=H.doc(html)\n                local item=parse_book(doc,direct)\n                last_detail={id=direct,time=ctx.clock.now(),html=html}\n                result={items={item},total=1,has_more=false,pagination={mode=\"page\",page=1,pages=1,page_size=1}}\n            else result=list(html,p,false,true)end\n            search_http.rememberSearch(keyword,p,html,path)\n            return result\n        end)\n    end\n    local categories={{id=\"0\",title=\"全部\"},{id=\"1\",title=\"电击文库\"},{id=\"2\",title=\"富士见文库\"},\n        {id=\"3\",title=\"角川文库\"},{id=\"4\",title=\"MF文库J\"},{id=\"5\",title=\"Fami通文库\"},\n        {id=\"6\",title=\"GA文库\"},{id=\"7\",title=\"HJ文库\"},{id=\"8\",title=\"一迅社文库\"},\n        {id=\"9\",title=\"集英社\"},{id=\"10\",title=\"小学馆\"},{id=\"11\",title=\"讲谈社\"},\n        {id=\"12\",title=\"少女文库\"},{id=\"13\",title=\"其他文库\"},{id=\"14\",title=\"华文轻小说\"},{id=\"15\",title=\"Web轻小说\"}}\n    local sorts={{id=\"lastupdate\",title=\"最近更新\"},{id=\"weekvisit\",title=\"周人气\"},{id=\"monthvisit\",title=\"月人气\"},{id=\"weekvote\",title=\"周推荐\"},{id=\"monthvote\",title=\"月推荐\"},{id=\"words\",title=\"字数\"},{id=\"goodnum\",title=\"收藏数\"},{id=\"postdate\",title=\"最新入库\"}}\n    -- Verified site topic catalogue (2026-10-27); keeping the picker offline.\n    local topics={\n        {id=\"tag:64\",title=\"恋爱\"},\n        {id=\"tag:48\",title=\"后宫\"},\n        {id=\"tag:63\",title=\"校园\"},\n        {id=\"tag:27\",title=\"百合\"},\n        {id=\"tag:26\",title=\"转生\"},\n        {id=\"tag:47\",title=\"异世界\"},\n        {id=\"tag:15\",title=\"奇幻\"},\n        {id=\"tag:61\",title=\"冒险\"},\n        {id=\"tag:222\",title=\"欢乐向\"},\n        {id=\"tag:231\",title=\"女性视角\"},\n        {id=\"tag:219\",title=\"龙傲天\"},\n        {id=\"tag:96\",title=\"魔法\"},\n        {id=\"tag:67\",title=\"青春\"},\n        {id=\"tag:31\",title=\"性转\"},\n        {id=\"tag:198\",title=\"病娇\"},\n        {id=\"tag:217\",title=\"妹妹\"},\n        {id=\"tag:225\",title=\"青梅竹马\"},\n        {id=\"tag:18\",title=\"战斗\"},\n        {id=\"tag:256\",title=\"NTR\"},\n        {id=\"tag:223\",title=\"人外\"},\n        {id=\"tag:227\",title=\"大小姐\"},\n        {id=\"tag:189\",title=\"黑暗\"},\n        {id=\"tag:68\",title=\"悬疑\"},\n        {id=\"tag:56\",title=\"科幻\"},\n        {id=\"tag:201\",title=\"伪娘\"},\n        {id=\"tag:55\",title=\"战争\"},\n        {id=\"tag:185\",title=\"萝莉\"},\n        {id=\"tag:229\",title=\"复仇\"},\n        {id=\"tag:199\",title=\"斗智\"},\n        {id=\"tag:131\",title=\"异能\"},\n        {id=\"tag:241\",title=\"猎奇\"},\n        {id=\"tag:191\",title=\"轻文学\"},\n        {id=\"tag:60\",title=\"职场\"},\n        {id=\"tag:226\",title=\"经营\"},\n        {id=\"tag:246\",title=\"JK\"},\n        {id=\"tag:135\",title=\"机战\"},\n        {id=\"tag:261\",title=\"女儿\"},\n        {id=\"tag:221\",title=\"末日\"},\n        {id=\"tag:220\",title=\"犯罪\"},\n        {id=\"tag:239\",title=\"旅行\"},\n        {id=\"tag:124\",title=\"惊悚\"},\n        {id=\"tag:98\",title=\"治愈\"},\n        {id=\"tag:97\",title=\"推理\"},\n        {id=\"tag:205\",title=\"日本文学\"},\n        {id=\"tag:248\",title=\"游戏\"},\n        {id=\"tag:228\",title=\"耽美\"},\n        {id=\"tag:211\",title=\"美食\"},\n        {id=\"tag:245\",title=\"群像\"},\n        {id=\"tag:249\",title=\"大逃杀\"},\n        {id=\"tag:233\",title=\"音乐\"},\n        {id=\"tag:132\",title=\"格斗\"},\n        {id=\"tag:28\",title=\"热血\"},\n        {id=\"tag:180\",title=\"温馨\"},\n        {id=\"tag:224\",title=\"脑洞\"},\n        {id=\"tag:328\",title=\"恶役\"},\n        {id=\"tag:304\",title=\"JC\"},\n        {id=\"tag:254\",title=\"间谍\"},\n        {id=\"tag:146\",title=\"竞技\"},\n        {id=\"tag:263\",title=\"宅文化\"},\n        {id=\"tag:333\",title=\"同人\"},\n    }\n    local topic_ids={}\n    for _,topic in ipairs(topics)do topic_ids[topic.id]=true end\n    function S:getCategories()\n        local out=ctx.json.decode(ctx.json.encode(topics))\n        for _,category in ipairs(categories)do out[#out+1]=ctx.json.decode(ctx.json.encode(category)) end\n        return true,out,nil\n    end\n    function S:getSortOptions(kind)\n        if kind==\"recommend\" then return true,{{id=\"weekvisit\",title=\"周人气\"},{id=\"weekvote\",title=\"周推荐\"},{id=\"monthvisit\",title=\"月人气\"},{id=\"monthvote\",title=\"月推荐\"},{id=\"words\",title=\"字数\"}},nil end\n        return true,kind==\"category\" and sorts or {},nil\n    end\n    function S:getCategoryComics(id,request,call)\n        return H.run(\"getCategoryComics\",function()\n            local tag,publisher=\"0\",\"0\"\n            if topic_ids[id] then tag=id:sub(5)\n            else H.id(id);assert(tonumber(id)<=15,\"unknown category\");publisher=id end\n            local p=H.page(request);local sort=request and request.sort or \"lastupdate\"\n            assert(({weekvisit=true,monthvisit=true,weekvote=true,monthvote=true,lastupdate=true,words=true,goodnum=true,postdate=true})[sort],\"invalid sort\")\n            return list(H.get(\"/wenku/\"..sort..\"_\"..tag..\"_\"..publisher..\"_0_0_0_0_0_\"..p..\"_0.html\",call),p)\n        end)\n    end\n    local function detail(id,call)\n        H.id(id)\n        if last_detail and last_detail.id==id and ctx.clock.now()-last_detail.time<180 then return H.doc(last_detail.html) end\n        local html=H.get(\"/novel/\"..id..\".html\",call);local doc=H.doc(html)\n        assert(meta(doc,\"og:novel:book_name\"),\"missing detail\")\n        last_detail={id=id,time=ctx.clock.now(),html=html};return doc\n    end\n    parse_book=function(doc,id)\n        local title=meta(doc,\"og:novel:book_name\");assert(title and title~=\"\",\"missing title\")\n        local categories,seen={},{}\n        local publisher=meta(doc,\"og:novel:category\")\n        if publisher and publisher~=\"\" then categories[1]=publisher;seen[publisher]=true end\n        for _,tag in ipairs(doc:select(\".tag-small a\")) do local value=H.text(tag);if value~=\"\" and not seen[value] then categories[#categories+1]=value;seen[value]=true end end\n        local description=H.text(H.first(doc,\"#bookSummary content\"))\n        if description==\"\" then description=meta(doc,\"og:description\") end\n        local out={id=id,title=title,author=meta(doc,\"og:novel:author\"),categories=categories,\n            description=description,cover=H.url(meta(doc,\"og:image\")),metadata={}}\n        local status=meta(doc,\"og:novel:status\")\n        if status==\"完结\" or status==\"已完结\" or status==\"已完成\" then out.finished=true\n        elseif status==\"连载\" or status==\"连载中\" then out.finished=false end\n        local updated=meta(doc,\"og:novel:update_time\")\n        if updated then out.updated_at=updated:match(\"^(%d%d%d%d%-%d%d%-%d%d)\") end\n        for _,node in ipairs(doc:select(\".book-meta\")) do\n            local text=H.text(node)\n            local words=text:match(\"^([%d%.]+%s*万字)\") or text:match(\"^([%d,]+%s*字)\")\n            if words then out.metadata.word_count=words;break end\n        end\n        return out\n    end\n    function S:getManga(id,call)\n        return H.run(\"getManga\",function()return parse_book(detail(id,call),id)end)\n    end\n    function S:getChapters(id,request,call)\n        return H.run(\"getChapters\",function()\n            H.firstPage(request);H.id(id)\n            local doc=H.doc(H.get(\"/novel/\"..id..\"/catalog\",call));local items,seen={},{}\n            local rows=doc:select(\".volume-chapters li\")\n            if #rows==0 then rows=doc:select(\"li.jsChapter\") end\n            local groups,group={},nil\n            for _,row in ipairs(rows) do\n                local class=\" \"..H.attr(row,\"class\")..\" \"\n                if class:find(\" chapter-bar \",1,true) then\n                    group={title=H.text(row),rows={},path=H.attr(H.first(row,\"a\"),\"href\")}\n                    groups[#groups+1]=group\n                elseif class:find(\" jsChapter \",1,true) then\n                    if not group then group={rows={}};groups[#groups+1]=group end\n                    local a=assert(H.first(row,\"a\"),\"missing chapter link\")\n                    group.rows[#group.rows+1]={title=H.text(a),href=H.attr(a,\"href\")}\n                    if not H.attr(a,\"href\"):match(\"^/novel/\"..id..\"/%d+%.html$\") then group.hidden=true end\n                end\n            end\n            local function progress(done)\n                if call and call.on_progress then call.on_progress({completed=done,total=#groups})end\n            end\n            progress(0)\n            for group_index,g in ipairs(groups) do\n                if g.hidden then\n                    -- The site's public volume page often supplies explicit\n                    -- links omitted from the aggregate directory. Verify the\n                    -- entire sequence against the same volume before using it.\n                    if not g.path or not g.path:match(\"^/novel/\"..id..\"/vol_%d+%.html$\") then H.unsupported(\"站点未提供完整章节地址，请在原站检查目录\") end\n                    local volume=H.doc(H.get(g.path,call))\n                    local links=volume:select(\"li.jsChapter a\")\n                    if #links~=#g.rows then H.unsupported(\"分卷目录与全书目录不一致，暂不能确认完整章节\") end\n                    for i,a in ipairs(links) do\n                        local href=H.attr(a,\"href\")\n                        local known=g.rows[i].href:match(\"^/novel/\"..id..\"/%d+%.html$\")\n                        if not href:match(\"^/novel/\"..id..\"/%d+%.html$\")\n                            or known and g.rows[i].href~=href or not known and H.text(a)~=g.rows[i].title then\n                            H.unsupported(\"站点未提供可核对的完整分卷目录\")\n                        end\n                        g.rows[i].href=href\n                        g.rows[i].title=H.text(a)\n                    end\n                end\n                for _,row in ipairs(g.rows) do\n                    local bid,cid=row.href:match(\"^/novel/(%d+)/(%d+)%.html$\")\n                    if not cid then H.unsupported(\"站点隐藏了部分章节地址，当前无法确认完整目录\") end\n                    assert(bid==id and not seen[cid] and row.title~=\"\",\"invalid chapter identity\");seen[cid]=true\n                    items[#items+1]={id=cid,title=g.title and g.title..\" · \"..row.title or row.title}\n                end\n                progress(group_index)\n            end\n            assert(#items>0,\"missing catalogue\");return {items=items,has_more=false}\n        end)\n    end\n    local function decode(doc,body,cid,call)\n        local path\n        for _,script in ipairs(doc:select(\"script\")) do\n            local url=H.attr(script,\"src\")\n            if url:find(\"chapterlog.js\",1,true) then\n                -- The official page also names the .net asset mirror. Fetch\n                -- its exact script path through our existing same-origin route.\n                url=url:match(\"^https://www%.bilinovel%.net(/.*)$\") or url\n                if url:sub(1,#H.base)==H.base then url=url:sub(#H.base+1) end\n                assert(url:match(\"^/themes/zhmb/js/chapterlog%.js%?[%w%.=_%-]+$\"),\"unknown chapter script origin\")\n                path=url\n            end\n        end\n        if not path then return body:getcontent() end\n        if not script_cache or script_cache.path~=path or ctx.clock.now()-script_cache.time>=300 then\n            script_cache={path=path,time=ctx.clock.now(),parameters=D.parameters(H.get(path,call))}\n        end\n        return D.restore(body,cid,script_cache.parameters)\n    end\n    function S:getChapterContent(id,cid,call)\n        return H.run(\"getChapterContent\",function()\n            local path=\"/novel/\"..H.id(id)..\"/\"..H.id(cid)..\".html\"\n            local parts,seen,total={},{},0\n            for page=1,64 do\n                assert(not seen[path],\"chapter pagination loop\");seen[path]=true\n                local html=H.get(path,call)\n                if html:find(\"內容加載失敗\",1,true) or html:find(\"内容加载失败\",1,true) then H.unsupported(\"站点未返回完整正文，已拦截残缺章节\") end\n                local book=html:match(\"articleid:%s*'(%d+)'\")\n                local chapter=html:match(\"chapterid:%s*'(%d+)'\")\n                assert(not book or book==id,\"wrong chapter parent\");assert(not chapter or chapter==cid,\"wrong chapter identity\")\n                if html:match(\"chapterisvip:%s*'[1-9]'\") then H.unsupported(\"本章需要站点授权，当前无法读取\") end\n                local doc=H.doc(html);local body=assert(H.first(doc,\"#acontent\"),\"missing chapter body\")\n                local content=decode(doc,body,cid,call);total=total+#content;assert(total<=262144,\"chapter too large\")\n                parts[#parts+1]=content\n                local next_path=html:match(\"url_next:%s*'([^']+)'\");assert(next_path,\"missing pagination data\")\n                local bid,next_cid,n=next_path:match(\"^/novel/(%d+)/(%d+)_(%d+)%.html$\")\n                if bid==id and next_cid==cid then assert(tonumber(n)==page+1,\"chapter pages out of order\");path=next_path\n                else\n                    local next_bid=next_path:match(\"^/novel/(%d+)/\")\n                    assert(next_bid==id,\"unexpected next chapter target\")\n                    return {format=\"html\",html=table.concat(parts,\"\\n\"),base_url=H.base..path,complete=true}\n                end\n            end\n            error(ctx.error(\"resource_limit\",\"章节分页超过限额\"),0)\n        end)\n    end\n    function S:getImageRequest(resource)return ctx.imageRequest(resource,{Referer=H.base..\"/\"},20)end\n    return S\nend\n"},"format":1,"manifest":{"api_version":3,"author":"PicaYomi contributors","cache_schema_version":1,"content_type":"novel","data_schema_version":1,"entry":"main.lua","id":"bilinovel","identity_policy":"stable","min_app_version":"1.1.7","name":"哔哩轻小说","publisher_id":"picayomi.bilinovel","text_filters":[],"version":"1.0.4"}}